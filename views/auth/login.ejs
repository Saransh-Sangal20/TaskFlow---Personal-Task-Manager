<% layout("layouts/auth_boilerplate.ejs") %>
<div class="container">
    <div class="row justify-content-center align-items-center mt-5 pt-5">
        <div class="col-12 col-sm-10 col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h4 class="card-title text-center mb-3">TaskFlow – Welcome Back!</h4>
                    <form action="/login" method="POST">
                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input type="text" id="username" placeholder="Enter Username" class="form-control" name="username" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" id="password" placeholder="Enter Password" class="form-control" name="password" required>
                        </div>
                        <button type="submit" class="btn btn-dark w-100 border-0" style="background-color: #fe424d;">Login</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
