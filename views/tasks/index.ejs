<% layout("layouts/boilerplate.ejs") %>  <!--layout path is relative to views folder-->
<body>
    <div class="container ms-3">
        <h2 class="mb-3">All Tasks</h2>
        <!--conditional rendering for empty task list-->
        <% if (allTasks.length===0) { %>
            <div class="text-center mt-5">
                <h4>No tasks found</h4>
                <p class="text-muted">Start by adding your first task.</p>
            </div>
        <% } else { %>
            <div class="row g-2">
            <% for (let task of allTasks) { %>
                <div class="col-12 col-md-6 col-lg-4 col-xl-3 mb-3">
                    <div class="card h-100" style="width: 18rem;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title"><%= task.title %></h5>
                            <!--conditional rendering for different status-->
                            <% if (task.status==="pending") { %>
                                <h6 class="card-subtitle mb-2 text-danger"><b><%= task.status %></b></h6>
                            <% } else if (task.status==="in progress") { %>
                                <h6 class="card-subtitle mb-2 text-warning"><b><%= task.status %></b></h6>
                            <% } else { %>
                                <h6 class="card-subtitle mb-2 text-success"><b><%= task.status %></b></h6>
                            <% } %>
                            <p class="card-text"><%= task.description %></p>
                            <div class="d-flex mt-auto">
                                <a href="/tasks/<%= task._id %>/edit" class="btn btn-dark me-2"><i class="fa-solid fa-pen-to-square" alt="edit"></i></a>
                                <form action="/tasks/<%= task._id %>?_method=DELETE" method="POST">
                                    <button type="submit" class="btn btn-dark border-0" style="background-color: #fe424d;"><i class="fa-solid fa-trash" alt="delete"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
            </div>
        <% } %>
    </div>
</body>